includes:
    - vendor/larastan/larastan/extension.neon
    # Uncomment after generating the baseline (step 4):
    # - phpstan-baseline.neon

parameters:
    level: 2

    # Baseline is a noise bucket; don't flag when baselined errors occur
    # fewer times than recorded (that just means you cleaned some up).
    reportUnmatchedIgnoredErrors: false

    paths:
        - app

    # new static() in these traits is safe: every consumer is an Eloquent
    # model with the standard (array $attributes = []) constructor.
    ignoreErrors:
        -
            identifier: new.static
            path: app/Traits/*.php
        # Report resources wrap aggregated query rows (no backing model),
        # so magic-property access can't be resolved; ignore just those.
        -
            identifier: property.notFound
            path: app/Http/Resources/Api/Reports/*

        # --- Dynamic Eloquent access (not real bugs) ---------------------------
        # Aggregate/join/DB-view queries (SUM(..) as x, "col as alias", UNION
        # views, MorphTo) hydrate into a generic Eloquent model, or a specific
        # model carrying alias columns that don't exist on its table. That access
        # is correct at runtime but unprovable statically. We relax the
        # column-existence check in the procedural layers where such rows are
        # consumed (controllers/services/console). Models and (non-report)
        # Resources keep it ON — that's where a genuine "missing column" bug
        # (e.g. a resource exposing a field that isn't on the table) shows up.

        # Type was lost entirely (generic base Model) — can't prove anything.
        -
            identifier: property.notFound
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:#'
        -
            identifier: property.notFound
            path: app/Http/Controllers/*
        -
            identifier: property.notFound
            path: app/Services/*
        -
            identifier: property.notFound
            path: app/Console/*

